{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "cd .. && markdownlint-cli2 '**/*.md' '#node_modules' '#frontend/node_modules'",
    "lint:md:fix": "cd .. && markdownlint-cli2 --fix '**/*.md' '#node_modules' '#frontend/node_modules'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "generate:api": "orval --config orval.config.ts",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:storybook": "vitest --config vitest.storybook.config.ts --run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "cd .. && git config core.hooksPath .husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.5.1",
    "@eslint/eslintrc": "^3.3.7",
    "@faker-js/faker": "^10.6.0",
    "@next/bundle-analyzer": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-onboarding": "^10.6.2",
    "@storybook/addon-themes": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/nextjs-vite": "^10.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-storybook": "^10.6.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.24.0",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^2.0.7",
    "orval": "^8.44.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.30",
    "prettier": "^3.9.9",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "pnpm": {
    "overrides": {
      "@isaacs/brace-expansion@<=5.0.0": ">=5.0.1",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2 <5",
      "micromatch@<4.0.8": ">=4.0.8",
      "glob>minimatch": ">=10.2.3",
      "@typescript-eslint/typescript-estree>minimatch": ">=10.2.3",
      "typedoc>minimatch": ">=10.2.3",
      "@eslint/eslintrc>minimatch": "^3.1.4",
      "eslint>minimatch": "^3.1.4",
      "@eslint/config-array>minimatch": "^3.1.4",
      "eslint-plugin-import>minimatch": "^3.1.4",
      "eslint-plugin-jsx-a11y>minimatch": "^3.1.4",
      "eslint-plugin-react>minimatch": "^3.1.4",
      "@storybook/csf-plugin>rollup": ">=4.59.0",
      "vite>rollup": ">=4.59.0",
      "@eslint/eslintrc>ajv": "^6.14.0",
      "eslint>ajv": "^6.14.0",
      "@scalar/openapi-parser>ajv": ">=8.18.0",
      "markdown-it@<14.3.1": ">=14.3.1 <15",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=3.0.0 <5.0.12": "^5.0.12",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-26996",
        "CVE-2026-93687"
      ]
    }
  }
}
